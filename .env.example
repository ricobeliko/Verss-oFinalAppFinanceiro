# FinControl — Variáveis de Ambiente (Frontend)
# =================================================
# Copie este arquivo para .env e preencha os valores.
# O arquivo .env NUNCA deve ser commitado (está no .gitignore).
#
# IMPORTANTE: As variáveis VITE_FIREBASE_* são públicas por design do Firebase Web SDK.
# Elas aparecem no bundle JavaScript e isso é esperado e seguro.
# NÃO confundir com secrets reais — secrets do backend ficam no GCP Secret Manager.
#
# Para obter os valores: Firebase Console → Configurações do Projeto → Seus apps → Web

VITE_FIREBASE_API_KEY=sua-api-key-aqui
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# Firebase App Check (reCAPTCHA Enterprise Site Key — identificador público de cliente)
# Obtenha em: Firebase Console → App Check → Apps → Web App
VITE_FIREBASE_APPCHECK_SITE_KEY=

# ==================================================
# Secrets de backend (NÃO coloque aqui — use GCP Secret Manager)
# ==================================================
# MERCADOPAGO_ACCESS_TOKEN → GCP Secret Manager: "MERCADOPAGO_ACCESS_TOKEN"
# GEMINI_API_KEY           → GCP Secret Manager: "GEMINI_API_KEY"
#
# ⚠️ GATE DE ATIVAÇÃO DA IA:
# A chave GEMINI_API_KEY NÃO deve ser provisionada em produção até que
# rate limiting esteja implementado em functions/index.js.
# Ver: docs/release-process.md → Seção 10
