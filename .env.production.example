# FinControl — Configuração de Produção (Template)
# ATENÇÃO: Contém apenas identificadores públicos do Firebase Web SDK.
# NUNCA insira tokens de API privados, segredos do Secret Manager ou chaves de serviço aqui.
VITE_FIREBASE_API_KEY=YOUR_PRODUCTION_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=controle-de-cartao.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=controle-de-cartao
VITE_FIREBASE_STORAGE_BUCKET=controle-de-cartao.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=364725310124
VITE_FIREBASE_APP_ID=YOUR_PRODUCTION_APP_ID
VITE_FIREBASE_APPCHECK_SITE_KEY=YOUR_RECAPTCHA_ENTERPRISE_SITE_KEY
VITE_USE_FIREBASE_EMULATOR=false
