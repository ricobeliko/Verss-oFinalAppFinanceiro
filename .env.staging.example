# FinControl — Configuração de Staging (Template)
# O Staging deve apontar para um projeto Firebase TOTALMENTE ISOLADO de produção.
# NUNCA aponte para controle-de-cartao ou demo-fincontrol-e2e neste ambiente!
VITE_FIREBASE_API_KEY=YOUR_STAGING_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=fincontrol-teste-cartao.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fincontrol-teste-cartao
VITE_FIREBASE_STORAGE_BUCKET=fincontrol-teste-cartao.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=694644180479
VITE_FIREBASE_APP_ID=YOUR_STAGING_APP_ID
VITE_FIREBASE_APPCHECK_SITE_KEY=YOUR_STAGING_RECAPTCHA_SITE_KEY
VITE_USE_FIREBASE_EMULATOR=false
