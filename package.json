{
  "name": "meu-app-reconstruido",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:production": "node scripts/validate-firebase-environment.mjs production && vite build --mode production",
    "build:staging": "node scripts/validate-firebase-environment.mjs staging && vite build --mode staging",
    "test": "vitest run",
    "test:rules": "vitest run tests/firestoreRules.test.js",
    "test:functions": "vitest run tests/cloudFunctions.test.js",
    "test:integration": "vitest run tests/workflowIntegration.test.js",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "watch-css": "tailwindcss -i ./src/index.css -o ./src/tailwind-output.css --watch"
  },
  "dependencies": {
    "firebase": "^10.12.2",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@eslint/js": "8.57.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "13.24.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "react": "^18.3.1"
  }
}
